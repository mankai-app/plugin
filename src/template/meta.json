{
  "id": "template",
  "name": "Template Plugin",
  "version": "1.0.0",
  "authors": ["ME"],
  "description": "A template plugin.",
  "localizations": {
    "zh-Hans": {
      "name": "模板插件",
      "description": "用于创建 Mankai 插件的模板。"
    },
    "zh-Hant": {
      "name": "範本外掛",
      "description": "用於建立 Mankai 外掛的範本。",
      "availableCustomGenres": ["異世界", "日常"],
      "availableCustomSorts": ["依標題排序"],
      "configs": {
        "select_config": {
          "name": "選擇設定",
          "description": "從清單中選擇一個選項。",
          "options": {
            "option1": "選項一",
            "option2": "選項二",
            "option3": "選項三"
          }
        }
      }
    },
    "ja": {
      "name": "テンプレートプラグイン",
      "description": "Mankai プラグインを作成するためのテンプレート。"
    }
  },
  "repository": "https://example.com",
  "updatesUrl": "https://example.com/updates",
  "getImageHeaders": {
    "User-Agent": "TemplatePlugin/1.0"
  },
  "availableGenres": [
    "action",
    "romance",
    "yuri",
    "boysLove",
    "schoolLife",
    "adventure",
    "harem",
    "speculativeFiction",
    "otokonoko",
    "war",
    "suspense",
    "fanFiction",
    "comedy",
    "magic",
    "horror",
    "historical",
    "sports",
    "mature",
    "mecha"
  ],
  "availableCustomGenres": ["Isekai", "Slice of Life"],
  "availableCustomSorts": ["Title"],
  "configs": [
    {
      "key": "text_config",
      "name": "Text Config",
      "description": "A simple text configuration option.",
      "type": "text",
      "defaultValue": "Default Text"
    },
    {
      "key": "password_config",
      "name": "Password Config",
      "description": "A simple password configuration option.",
      "type": "password",
      "defaultValue": "DefaultPassword"
    },
    {
      "key": "number_config",
      "name": "Number Config",
      "description": "A simple number configuration option.",
      "type": "number",
      "defaultValue": 42
    },
    {
      "key": "boolean_config",
      "name": "Boolean Config",
      "description": "A simple boolean configuration option.",
      "type": "boolean",
      "defaultValue": true
    },
    {
      "key": "select_config",
      "name": "Select Config",
      "description": "A simple select configuration option.",
      "type": "select",
      "defaultValue": "option1",
      "options": ["option1", "option2", "option3"]
    },
    {
      "key": "slider_config",
      "name": "Slider Config",
      "description": "A simple slider configuration option.",
      "type": "slider",
      "defaultValue": 50,
      "min": 0,
      "max": 100,
      "step": 10
    },
    {
      "key": "color_config",
      "name": "Color Config",
      "description": "A color with adjustable opacity.",
      "type": "color",
      "defaultValue": "#F2E4C9FF",
      "supportsOpacity": true
    }
  ],
  "cooldown": {
    "default": 1000,
    "getImage": 500,
    "getImageConcurrency": 10
  },
  "capabilities": [
    "onlineCheck",
    "suggestions",
    "list",
    "listByGenre",
    "listByCustomGenre",
    "listByStatus",
    "listByUpdateTime",
    "listByPopularity",
    "listByCustomSort",
    "search",
    "searchByGenre",
    "searchByCustomGenre",
    "searchByStatus",
    "searchByAuthor",
    "searchByUpdateTime",
    "searchByPopularity",
    "searchByCustomSort",
    "mangaDetails",
    "batchMangas",
    "mangaUpdates",
    "chapter",
    "image"
  ]
}
